{
  "manifest_version": 3,
  "name": "Go Links",
  "version": "1.0.0",
  "description": "Personal go/ link shortcuts for Safari. Type go/calendar to jump to saved URLs. Shortcuts stay private on this device.",
  "permissions": ["webNavigation", "tabs", "storage"],
  "host_permissions": [
    "*://go/*",
    "*://*.google.com/*",
    "*://*.bing.com/*",
    "*://*.duckduckgo.com/*",
    "*://*.search.yahoo.com/*",
    "*://*.ecosia.org/*",
    "*://search.brave.com/*",
    "*://*.startpage.com/*",
    "*://*.yandex.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module",
    "persistent": false
  },
  "omnibox": {
    "keyword": "go"
  },
  "action": {
    "default_title": "Go Links — quick add",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
